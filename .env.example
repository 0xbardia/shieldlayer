# === GenLayer Contract ===
# Set after deploying to GenLayer Studio
PUBLIC_CONTRACT_ADDRESS=0x8eDA3E60D6c9813Eff958fE4a7021370F0c49a7d
NEXT_PUBLIC_CONTRACT_ADDRESS=0x8eDA3E60D6c9813Eff958fE4a7021370F0c49a7d

# === GenLayer RPC ===
GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999

# === Local Mode (0 = production, 1 = local simulator) ===
GENLAYER_LOCAL_MODE=0

# === Redis (required in production; use memory:// for tests only) ===
REDIS_URL=redis://localhost:6379/0

# === API Keys ===
AVIATIONSTACK_API_KEY=your_aviationstack_key_here
OPENWEATHER_API_KEY=your_openweather_key_here

# === User Agents ===
NOAA_USER_AGENT=ShieldLayer/1.0
SEC_USER_AGENT=ShieldLayer/1.0

# === Security ===
TRUSTED_PROXIES=127.0.0.1,::1

# === WalletConnect (optional) ===
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# === CORS ===
CORS_ORIGINS=

# === Ports ===
API_PORT=8787
PORT=3456
API_INTERNAL_URL=http://127.0.0.1:8787

# === Deployment ===
SERVER_HOST=your_server_ip_here
