{
  "name": "shieldlayer",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:next": "next dev -p ${PORT:-3456}",
    "dev:api": "python3 api/server.py",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3456}",
    "start:prod": "bash scripts/start.sh",
    "stop": "bash scripts/safe-pm2.sh stop shieldlayer-api shieldlayer-frontend",
    "restart": "bash scripts/safe-pm2.sh restart shieldlayer-api shieldlayer-frontend",
    "delete": "bash scripts/safe-pm2.sh delete shieldlayer-api shieldlayer-frontend",
    "prestop": "echo 'Stopping ShieldLayer services only' && pm2 list | grep shieldlayer || true",
    "logs": "pm2 logs",
    "monit": "pm2 monit",
    "test": "bash scripts/test.sh",
    "test:js": "vitest run",
    "test:py": "python3 -m pytest tests/api tests/smart-contract tests/database tests/security -q",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "precommit": "npm run type-check && npm run lint && npm run test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@walletconnect/ethereum-provider": "^2.17.0",
    "clsx": "^2.1.1",
    "ethers": "^6.13.4",
    "framer-motion": "^11.11.9",
    "genlayer-js": "^1.1.8",
    "lucide-react": "^0.453.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.3"
  }
}
